APP_NAME=sapanjai-api
APP_ENV=development
PORT=3000
LOG_LEVEL=debug

# This one file serves both paths: `make api`/`make worker` on the host read it
# via godotenv, and compose passes it to the containerized api/worker as
# env_file. The two host-specific URLs below are the exception — compose
# overrides them per service, because only it knows the `db`/`redis` service
# hostnames, and godotenv never overrides an env var compose already set.
#
# DATABASE_USER/PASSWORD/NAME also configure the compose `db` container and the
# DATABASE_URL the containerized api/worker use — change them here and both the
# host and container paths follow. DATABASE_URL below is the host-side one
# (localhost, via the published port); compose builds its own with the `db`
# hostname. Keep the credentials in it in sync with the three vars above.
DATABASE_USER=username
DATABASE_PASSWORD=password
DATABASE_NAME=sapanjai
DATABASE_URL=postgres://username:password@localhost:5432/sapanjai?sslmode=disable

# Host-side; containers get redis://redis:6379 from compose.
REDIS_URL=redis://localhost:6379

JWT_ACCESS_SECRET=your-access-secret-min-32-chars-long
JWT_REFRESH_SECRET=your-refresh-secret-min-32-chars-long
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=604800

# Master key wrapping every connector's per-row data key (envelope
# encryption). base64 of exactly 32 bytes: openssl rand -base64 32
CONNECTOR_MASTER_KEY=JQ5uRM447OIEr/ty3J/+KKbXqDHQiKZnwdWcLKlOh/E=

# Optional, comma-separated: previous CONNECTOR_MASTER_KEY value(s), kept
# decrypt-only so rows sealed under an old key still open (rotate-on-read).
# To rotate: generate a new key, move the current CONNECTOR_MASTER_KEY value
# here, set CONNECTOR_MASTER_KEY to the new one, deploy. Once every row has
# been read at least once, drop the old value from here.
# CONNECTOR_MASTER_KEY_PREVIOUS=

# MCP gateway (internal/module/mcp): per-connector upstream-API rate limit,
# tokens/minute, enforced before a tools/call is dispatched
# (mcp:ratelimit:<connectorId> in Redis).
MCP_RATE_LIMIT_PER_MIN=60

# Background worker (cmd/worker)
WORKER_PORT=3001
WORKER_JOB_TIMEOUT=5m
SESSION_CLEANUP_INTERVAL=1h
SESSION_CLEANUP_RETENTION=720h
SESSION_CLEANUP_BATCH_SIZE=1000

# Transactional email (verification + password reset).
#
# APP_PUBLIC_URL is the browser-facing frontend origin the verification and
# reset links are built against — it must be where users actually reach the
# Next.js app, not the API. A trailing slash is trimmed.
APP_PUBLIC_URL=http://localhost:4000

# RESEND_API_KEY is read only by cmd/worker: the API renders and enqueues,
# and never talks to Resend. Leave it empty in development and the worker
# falls back to LogSender, which writes the whole rendered body — including
# the live link — to its own log, so you can click through with no Resend
# account. That fallback only logs bodies when APP_ENV is a local value;
# anywhere else it logs recipient + subject and returns an error, so a
# missing key surfaces in email_outbox.last_error instead of silently
# marking mail 'sent' that never left.
#
# EMAIL_FROM must be an address on a domain verified in the Resend
# dashboard, or Resend 403s every send.
RESEND_API_KEY=
EMAIL_FROM=Sapanjai <noreply@localhost>

# Outbox dispatch, worker-only. Claiming is lease-based: a run that dies
# mid-flight leaves its rows claimable again once the lease lapses, so there
# is no 'sending' status and no reaper. The lease is derived, not configured
# — WORKER_JOB_TIMEOUT + EMAIL_DISPATCH_INTERVAL, floored at 60s — because no
# run outlives the job timeout, and one interval of margin is the shortest
# lease that is always safe. EMAIL_OUTBOX_RETENTION is how long sent/failed
# rows are kept before the prune sweep deletes them (bodies are already
# nulled on send).
EMAIL_DISPATCH_INTERVAL=15s
EMAIL_DISPATCH_BATCH_SIZE=20
EMAIL_MAX_ATTEMPTS=5
EMAIL_OUTBOX_RETENTION=168h
