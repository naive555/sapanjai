APP_NAME=sapanjai-api
APP_ENV=development
PORT=3000
LOG_LEVEL=debug

# This one file serves both paths: `make api`/`make worker` on the host read it
# via godotenv, and compose passes it to the containerized api/worker as
# env_file. The two host-specific URLs below are the exception — compose
# overrides them per service, because only it knows the `db`/`redis` service
# hostnames, and godotenv never overrides an env var compose already set.
#
# DATABASE_USER/PASSWORD/NAME also configure the compose `db` container and the
# DATABASE_URL the containerized api/worker use — change them here and both the
# host and container paths follow. DATABASE_URL below is the host-side one
# (localhost, via the published port); compose builds its own with the `db`
# hostname. Keep the credentials in it in sync with the three vars above.
DATABASE_USER=username
DATABASE_PASSWORD=password
DATABASE_NAME=sapanjai
DATABASE_URL=postgres://username:password@localhost:5432/sapanjai?sslmode=disable

# Host-side; containers get redis://redis:6379 from compose.
REDIS_URL=redis://localhost:6379

# Prepended to every Redis key this app reads or writes, so an instance shared
# with another application cannot collide with ours. Several of our keys
# ("blacklist:", "login:attempts:", "verify:resend:") come from a platform-core
# template that sibling projects also derive from — on a shared Redis those
# would silently be the same counters.
#
# Must be IDENTICAL on the api and worker: they meet on
# "<prefix>worker:lock:<job>" and "<prefix>blacklist:<token>". Changing it
# orphans every live key — in-flight verification and password-reset links stop
# resolving and the blacklist forgets prior logouts. Nothing needs migrating;
# the orphans expire on their own TTLs. Set it to empty to opt out entirely.
REDIS_KEY_PREFIX=sapanjai:

JWT_ACCESS_SECRET=your-access-secret-min-32-chars-long
JWT_REFRESH_SECRET=your-refresh-secret-min-32-chars-long
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=604800

# Master key wrapping every connector's per-row data key (envelope
# encryption). base64 of exactly 32 bytes: openssl rand -base64 32
CONNECTOR_MASTER_KEY=JQ5uRM447OIEr/ty3J/+KKbXqDHQiKZnwdWcLKlOh/E=

# Optional, comma-separated: previous CONNECTOR_MASTER_KEY value(s), kept
# decrypt-only so rows sealed under an old key still open (rotate-on-read).
# To rotate: generate a new key, move the current CONNECTOR_MASTER_KEY value
# here, set CONNECTOR_MASTER_KEY to the new one, deploy. Once every row has
# been read at least once, drop the old value from here.
# CONNECTOR_MASTER_KEY_PREVIOUS=

# MCP gateway (internal/module/mcp): per-connector upstream-API rate limit,
# tokens/minute, enforced before a tools/call is dispatched
# (mcp:ratelimit:<connectorId> in Redis).
MCP_RATE_LIMIT_PER_MIN=60

# Password hashing (internal/shared/password): Argon2id cost, and how many
# hashes run at once across the API process. Peak hashing memory is
# MAX_CONCURRENT × MEMORY_KIB (defaults: 4 × 19 MiB ≈ 76 MiB) and must fit
# the container's memory limit. Boot fails below the weakest OWASP-listed
# profile (memory ≥ 7168 KiB and memory × iterations ≥ 35840). Changing the
# cost is safe: existing hashes keep verifying and are rehashed on login.
# PASSWORD_HASH_MEMORY_KIB=19456
# PASSWORD_HASH_ITERATIONS=2
# PASSWORD_HASH_PARALLELISM=1
# PASSWORD_HASH_MAX_CONCURRENT=4

# Background worker (cmd/worker)
WORKER_PORT=3001
WORKER_JOB_TIMEOUT=5m
SESSION_CLEANUP_INTERVAL=1h
SESSION_CLEANUP_RETENTION=720h
SESSION_CLEANUP_BATCH_SIZE=1000

# Connector health sweep, worker-only (internal/job/connectorhealth). Crosses
# every organization on an interval, re-probing each connector the same way
# POST /connectors/:id/health-check does, and emails the org owner only on an
# active->error transition (never on every interval a connector stays broken).
CONNECTOR_HEALTH_INTERVAL=6h
CONNECTOR_HEALTH_BATCH_SIZE=50

# Transactional email (verification + password reset).
#
# APP_PUBLIC_URL is the browser-facing frontend origin the verification and
# reset links are built against — it must be where users actually reach the
# Next.js app, not the API. A trailing slash is trimmed.
APP_PUBLIC_URL=http://localhost:4000

# RESEND_API_KEY is read only by cmd/worker: the API renders and enqueues,
# and never talks to Resend. Leave it empty in development and the worker
# falls back to LogSender, which writes the whole rendered body — including
# the live link — to its own log, so you can click through with no Resend
# account. That fallback only logs bodies when APP_ENV is a local value;
# anywhere else it logs recipient + subject and returns an error, so a
# missing key surfaces in email_outbox.last_error instead of silently
# marking mail 'sent' that never left.
#
# EMAIL_FROM must be an address on a domain verified in the Resend
# dashboard, or Resend 403s every send.
RESEND_API_KEY=
EMAIL_FROM=Sapanjai <noreply@localhost>

# Outbox dispatch, worker-only. Claiming is lease-based: a run that dies
# mid-flight leaves its rows claimable again once the lease lapses, so there
# is no 'sending' status and no reaper. The lease is derived, not configured
# — WORKER_JOB_TIMEOUT + EMAIL_DISPATCH_INTERVAL, floored at 60s — because no
# run outlives the job timeout, and one interval of margin is the shortest
# lease that is always safe. EMAIL_OUTBOX_RETENTION is how long sent/failed
# rows are kept before the prune sweep deletes them (bodies are already
# nulled on send).
EMAIL_DISPATCH_INTERVAL=15s
EMAIL_DISPATCH_BATCH_SIZE=20
EMAIL_MAX_ATTEMPTS=5
EMAIL_OUTBOX_RETENTION=168h

# Admin console (/admin, docs/11-admin-panel.md) hardening.
#
# ADMIN_IP_ALLOWLIST: comma-separated CIDRs. Parsed once at boot; a malformed
# entry fails startup rather than the first request. Empty/unset (the default
# below) DISABLES the check entirely — required for local dev, since nothing
# here resolves to a meaningful per-office/VPN address for traffic proxied
# through the frontend (see internal/server/server.go's e.IPExtractor comment
# and docs/09-railway-deploy.md for exactly what this filters and what it
# does not).
#
# *** A WRONG VALUE LOCKS EVERY PLATFORM STAFF ACCOUNT OUT OF /admin WITH NO
# IN-APP RECOVERY PATH. *** Recovery is: fix this variable, redeploy. There is
# no bypass, no break-glass account, and no way to fix it from inside the
# console it just locked you out of. Test any change against a non-empty
# value in staging before touching it in production.
ADMIN_IP_ALLOWLIST=

# ADMIN_REQUIRE_2FA: gates every /admin route except
# POST /admin/2fa/{enroll,confirm,verify} behind a confirmed TOTP step-up
# (12h Redis-cached, execution plan Task 6.3). Defaults true; set false only
# for local development — minting a TOTP enrollment for every throwaway
# seeded account is friction with no security benefit there.
ADMIN_REQUIRE_2FA=false

# Billing (internal/module/billing, docs/12-billing-and-metering.md). All
# three optional and empty by default: with no key, /billing/{checkout,portal}
# and /billing/webhook stay mounted and stay guarded, but answer
# 501 BILLING_NOT_CONFIGURED instead of calling Stripe — a developer with no
# Stripe account can still boot the API and run the full test suite.
#
# Unlike RESEND_API_KEY, this secret is held by the API, not only the worker:
# starting a checkout is request-driven and the webhook endpoint must be
# public, so there is no way to keep it off the internet-facing service the
# way the Resend key is kept off it. A restricted key (rk_...), scoped to only
# Checkout/Billing/Customer write, is what bounds the blast radius instead —
# never paste an account-wide secret key (sk_...) here.
STRIPE_SECRET_KEY=

# The signing secret for this deployment's webhook endpoint (whsec_...), a
# DIFFERENT secret from STRIPE_SECRET_KEY and not derivable from it — Stripe
# issues one per endpoint. It is the ONLY authentication
# POST /billing/webhook has (Stripe presents no JWT), so leaving this unset
# does not mean "accept everything": the route answers BILLING_NOT_CONFIGURED
# and reconciles nothing.
STRIPE_WEBHOOK_SECRET=

# Optional, comma-separated CIDRs narrowing POST /billing/webhook to Stripe's
# published egress ranges — defence in depth only, never the primary control
# (the signature check above is what actually authenticates a delivery).
# Same parsing and 404-not-403 behavior as ADMIN_IP_ALLOWLIST. Left unset by
# default: Stripe's IP ranges change over time, and a stale list here would
# silently drop live billing events.
STRIPE_WEBHOOK_IP_ALLOWLIST=

# Usage rollup, worker-only (internal/job/usagerollup). Folds the gateway's
# usage_events ledger into usage_rollups, cross-checks the count against
# audit_logs (mcp.tool.called) and logs any drift, then prunes usage_events
# rows past retention. USAGE_ROLLUP_BATCH_SIZE bounds one prune statement,
# following SESSION_CLEANUP_BATCH_SIZE's shape — the rollup itself is a
# single unbatched aggregate query.
USAGE_ROLLUP_INTERVAL=15m
USAGE_ROLLUP_BATCH_SIZE=1000
USAGE_EVENTS_RETENTION=2160h
