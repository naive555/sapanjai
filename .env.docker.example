# Template for .env.docker, which is git-ignored — copy it before the first
# containerized run:  cp .env.docker.example .env.docker
#
# Local dev only — used as env_file for the `api` and `worker` services in
# compose.yaml. Every value below is a throwaway placeholder, valid enough to
# boot the stack and worthless to an attacker. Before using this as a base for
# any real deployment, replace JWT_ACCESS_SECRET, JWT_REFRESH_SECRET, and
# CONNECTOR_MASTER_KEY with freshly generated values.
# Database credentials live in .env — see the DATABASE_URL note below.
APP_NAME=sapanjai-api
APP_ENV=development
PORT=3000
LOG_LEVEL=debug

# DATABASE_URL is intentionally absent: compose.yaml builds it for the api and
# worker services from the same DATABASE_USER/PASSWORD/NAME (and defaults) that
# configure the db container, so the two can't drift apart. Override those in
# .env, not here. Consequence: this file alone is not enough to run the image
# outside compose (`docker run --env-file .env.docker` needs DATABASE_URL too).
REDIS_URL=redis://redis:6379

JWT_ACCESS_SECRET=dev-access-secret-change-me-min-32-chars
JWT_REFRESH_SECRET=dev-refresh-secret-change-me-min-32-chars
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=604800

# Master key wrapping every connector's per-row data key (envelope
# encryption). base64 of exactly 32 bytes: openssl rand -base64 32
# The value below decodes to the literal string "dev-only-master-key-do-not-use!!"
# — it satisfies the length check so the stack boots, and nothing more.
CONNECTOR_MASTER_KEY=ZGV2LW9ubHktbWFzdGVyLWtleS1kby1ub3QtdXNlISE=

# Optional, comma-separated: previous CONNECTOR_MASTER_KEY value(s), kept
# decrypt-only so rows sealed under an old key still open (rotate-on-read).
# CONNECTOR_MASTER_KEY_PREVIOUS=

# Background worker (cmd/worker) — the worker service in compose.yaml
# overrides WORKER_PORT/HEALTHCHECK_PORT to 3001, but these defaults keep
# this file valid as env_file for both the api and worker services.
WORKER_PORT=3001
WORKER_JOB_TIMEOUT=5m
SESSION_CLEANUP_INTERVAL=1h
SESSION_CLEANUP_RETENTION=720h
SESSION_CLEANUP_BATCH_SIZE=1000
