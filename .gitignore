# Env — the .example templates alongside these are the tracked ones.
# The negation needs the **/ so it matches .env.example at the repo root and
# in any app dir; a bare `!.env.example.*` only covers suffixed variants like
# .env.example.local, which is not what the line above is for.
.env*
!**/.env.example

# Node / Next.js
node_modules/
apps/frontend/.next/
apps/frontend/out/
apps/frontend/.env.local

# Go
apps/backend/tmp/
apps/backend/bin/
# `go build ./cmd/x` drops its binary in the package root rather than bin/,
# so each cmd's name is also a stray ~38MB artifact one `git add -A` from
# being committed. Each path is anchored (it contains a slash, so it is
# relative to this file) precisely so it cannot also match the source
# directories of the same name under apps/backend/cmd/.
apps/backend/api
apps/backend/worker
apps/backend/migrate
apps/backend/seed
apps/backend/healthcheck

# K8s secrets
k8s/secret.yaml
k8s/**/secret.yaml

# Logs
*.log

# OS
.DS_Store
Thumbs.db
