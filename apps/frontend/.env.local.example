# Server-side only: where the runtime proxy (app/api/[...path]/route.ts)
# forwards /api/* requests. Read at request time, not baked into the build,
# so the same image works across environments (e.g. compose sets this to
# http://api:3000). The browser never calls this directly (same-origin
# /api/* only).
BACKEND_URL=http://localhost:3000

# Server-side only: the Sapanjai API host a connector's detail page tells an
# MCP client to point at (`POST {GATEWAY_URL}/mcp/:connectorId`) — read at
# request time by app/(dashboard)/connectors/[id]/page.tsx. This is the API
# host the browser or agent should reach, not this dashboard's own host, so
# it's deliberately not the same value as BACKEND_URL above whenever the two
# are reachable at different addresses (e.g. compose publishes the api
# service on host port 3000, but web reaches it internally as http://api:3000
# — the browser can only use the former). Unset falls back to whatever origin
# the dashboard itself is being viewed from, which is wrong the moment API and
# dashboard aren't the same host.
GATEWAY_URL=http://localhost:3000
